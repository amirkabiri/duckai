# Copy this file to .env and fill in the values captured from your browser
# session at https://duck.ai (see "Configuration" in the README).

# --- Server ---
PORT=3000
HOST=0.0.0.0

# --- Duck.ai client headers ---
# Copy the "User-Agent" header from a duck.ai chat request.
X_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36"

# Copy the "x-fe-signals" header from a duck.ai chat request.
X_FE_SIGNALS=

# Copy the "x-fe-version" header from a duck.ai chat request.
X_FE_VERSION=

# The stack string of the current duck.ai frontend bundle. It has to match the
# bundle referenced above, otherwise duck.ai rejects the VQD challenge.
X_VQD_STACK=

# --- Optional ---
# Set to "1" to expose the model reasoning as "reasoning_content" in responses.
# X_EMIT_REASONING=1

# Replace the built-in model list entirely (JSON object). See the README for
# the expected format.
# X_MODELS_JSON={"my-model":{"reasoning_effort":"none","valid_reasoning_efforts":["none","low"]}}
